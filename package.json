{
  "name": "roster-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "format": "biome format --write .",
    "league:build": "node apps/league/dist/build.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@roster/coach": "workspace:*",
    "@roster/combine": "workspace:*",
    "@roster/playbook": "workspace:*",
    "@roster/router": "workspace:*",
    "@roster/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
