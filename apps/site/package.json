{
  "name": "@roster/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "pnpm -w exec vitest run apps/site/test",
    "lint": "pnpm -w exec biome lint --error-on-warnings apps/site",
    "verify:links": "node scripts/check-links.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.10",
    "@iconify-json/tabler": "1.2.38",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
