---
import CapabilityIcon from "./CapabilityIcon.astro";
const vendors = [
  { name: "Figma", src: "/brands/figma.svg" },
  { name: "Slack", src: "/brands/slack.svg" },
  { name: "GitLab", src: "/hero-vendors/gitlab.svg" },
  { name: "Atlassian", src: "/hero-vendors/atlassian.svg" },
  { name: "MongoDB", src: "/hero-vendors/mongodb.svg" },
  { name: "Playwright", src: "/brands/playwright.svg" },
  { name: "Supabase", src: "/brands/supabase.svg" },
  { name: "Brave", src: "/brands/brave.svg" },
  { name: "PostgreSQL", src: "/brands/postgresql.svg" },
  { name: "Linear", src: "/brands/linear-color.svg" },
  { name: "GitHub", src: "/brands/github.svg" },
  { name: "Cloudflare", src: "/hero-vendors/cloudflare.svg" },
  { name: "Discord", src: "/hero-vendors/discord.svg" },
  { name: "Stripe", src: "/hero-vendors/stripe.svg" },
  { name: "Asana", src: "/hero-vendors/asana.svg" },
  { name: "Docker", src: "/hero-vendors/docker.svg" },
  { name: "Neon", src: "/hero-vendors/neon.svg" },
  { name: "Netlify", src: "/hero-vendors/netlify.svg" },
  { name: "PayPal", src: "/hero-vendors/paypal.svg" },
  { name: "Shopify", src: "/hero-vendors/shopify.svg" },
  { name: "Todoist", src: "/hero-vendors/todoist.svg" },
  { name: "Sentry", src: "/hero-vendors/sentry.svg" },
  { name: "ClickUp", src: "/hero-vendors/clickup.svg" },
  { name: "Redis", src: "/hero-vendors/redis.svg" },
  { name: "Svelte", src: "/hero-vendors/svelte.svg" },
];
const slopes = [-0.54, -0.36, -0.18, 0, 0.18, 0.36, 0.54];
const laneCount = slopes.length * 2;
const slots = [
  ...Array.from({ length: laneCount }, (_, index) => ({ index, layer: 0 })),
  ...[0, 1, 5, 6, 7, 8, 9, 10, 11, 12, 13].map((index) => ({ index, layer: 1 })),
];
if (slots.length !== vendors.length || new Set(vendors.map(({ name }) => name)).size !== vendors.length || new Set(vendors.map(({ src }) => src)).size !== vendors.length) throw new Error("Hero brands must be unique and match the available depth slots.");
const placements = vendors.map((vendor, slot) => ({ vendor, ...slots[slot]! }));
---
<logo-depth class="logo-depth" data-motion="paused">
  <div class="logo-depth-scene" aria-hidden="true">
    {placements.map(({ vendor, index, layer }) => {
      const direction = index % 2 === 0 ? -1 : 1;
      const slope = slopes[Math.floor(index / 2)]!;
      const duration = 20 + (index % 3) * 2;
      const delay = -(((index * 2 + 0.5) % laneCount) / laneCount + layer / 2) * duration;
      return <span class="depth-logo" data-vendor={vendor.name} style={`--desktop-x: calc(min(43vw, 620px) * ${direction}); --desktop-y: calc(min(43vw, 620px) * ${slope}); --desktop-rest-depth: ${layer === 0 ? -400 : 0}px; --logo-rotation: ${(index * 7) % 13 - 6}deg; --logo-delay: ${delay}s; --logo-duration: ${duration}s; --mobile-x: ${(index % 3 - 1) * 116}px; --mobile-y: ${index < 3 ? -42 : 42}px`}>
        {vendor.name === "GitHub" ? <CapabilityIcon name="github" size={44} /> : <img src={vendor.src} width="44" height="44" alt="" decoding="async" />}
      </span>;
    })}
  </div>
</logo-depth>
<script>
  class LogoDepth extends HTMLElement {
    private observer?: IntersectionObserver;
    private reduced = matchMedia("(prefers-reduced-motion: reduce)");
    private inView = false;
    private startedAt?: number;
    private frame?: number;
    // A single short introduction avoids an unbounded animation without a control.
    private readonly motionDuration = 4500;
    private tick = (now: number) => {
      const elapsed = now - (this.startedAt ?? now);
      if (elapsed >= this.motionDuration) {
        this.dataset.motion = "settled";
        this.frame = undefined;
        return;
      }
      const progress = Math.max(0, (elapsed - 2500) / 2000);
      const rate = 1 - progress * progress * (3 - 2 * progress);
      for (const animation of this.getAnimations({ subtree: true })) {
        animation.updatePlaybackRate(rate);
      }
      this.frame = requestAnimationFrame(this.tick);
    };
    private update = () => {
      if (this.frame !== undefined) cancelAnimationFrame(this.frame);
      this.frame = undefined;
      const now = performance.now();
      const settled = this.startedAt !== undefined && now - this.startedAt >= this.motionDuration;
      const running = this.inView && !document.hidden && !this.reduced.matches && !settled;
      this.dataset.motion = this.reduced.matches ? "still" : settled ? "settled" : running ? "running" : "paused";
      if (running) {
        this.startedAt ??= now;
        this.tick(now);
      }
    };
    connectedCallback() {
      this.reduced.addEventListener("change", this.update);
      document.addEventListener("visibilitychange", this.update);
      this.observer = new IntersectionObserver(([entry]) => {
        this.inView = entry?.isIntersecting ?? false;
        this.update();
      });
      this.observer.observe(this);
      this.update();
    }
    disconnectedCallback() {
      if (this.frame !== undefined) cancelAnimationFrame(this.frame);
      this.observer?.disconnect();
      this.reduced.removeEventListener("change", this.update);
      document.removeEventListener("visibilitychange", this.update);
    }
  }
  if (!customElements.get("logo-depth")) customElements.define("logo-depth", LogoDepth);
</script>
