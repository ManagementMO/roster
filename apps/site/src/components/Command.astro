---
import { Code, Tabs, TabItem } from "@astrojs/starlight/components";
import { commands, commandsFor, release } from "../lib/site.js";
import CopyButton from "./CopyButton.astro";
import Icon from "./Icon.astro";
interface Props { name: keyof typeof commands; title?: string; presentation?: "code" | "setup" }
const { name, title, presentation = "code" } = Astro.props;
const variants = [
  { label: "macOS / Linux", language: "bash", accessibleName: "Setup command for macOS and Linux", text: commands[name] },
  { label: "Windows", language: "powershell", accessibleName: "Setup command for Windows", text: commandsFor(release, "windows")[name] },
];
---
<div class:list={["terminal-command", { "terminal-setup": presentation === "setup" }]} data-command={name}>
  <Tabs syncKey="roster-terminal">
    {variants.map((variant) => <TabItem label={variant.label}>
      {presentation === "setup" ? <div class="source-install">
        <div class="install-heading"><span><Icon name="terminal-2" size={18} />{release.published ? "Set up Roster" : "Install from source"}</span><CopyButton text={variant.text} label={release.published ? "Copy setup command" : "Copy source commands"} /></div>
        <textarea class="command-text" rows={release.published ? 2 : 6} wrap="off" readonly spellcheck="false" aria-label={variant.accessibleName} translate="no">{variant.text}</textarea>
      </div> : <div translate="no"><Code code={variant.text} lang={variant.language} title={title} /></div>}
    </TabItem>)}
  </Tabs>
</div>
<style>
  .terminal-command { min-width: 0; --sl-line-height-headings: 1.3; --sl-outline-offset-inside: -3px; }
  .terminal-command :global(.tablist-wrapper) { padding-bottom: 8px; }
  .terminal-command :global([role="tablist"]) { display: inline-flex; gap: 4px; margin: 0; padding: 3px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface-soft); }
  .terminal-command :global(.tab > [role="tab"]) { min-height: 40px; padding: 8px 13px; border-radius: 6px; box-shadow: none; color: var(--muted); font-size: 12px; font-weight: 650; white-space: nowrap; }
  .terminal-command :global(.tab > [role="tab"][aria-selected="true"]) { background: var(--surface); color: var(--text); box-shadow: var(--shadow-control); }
  .terminal-command :global(.tab > [role="tab"]:hover) { color: var(--text); }
  .terminal-command :global(.tablist-wrapper ~ [role="tabpanel"]) { margin-top: 0; }
</style>
