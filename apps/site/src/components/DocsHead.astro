---
const { head } = Astro.locals.starlightRoute;
const filtered = head.filter(({ attrs }) => Astro.site || (attrs?.rel !== "canonical" && attrs?.property !== "og:url"));
---
{filtered.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<link rel="preload" href="/fonts/Manrope.woff2" as="font" type="font/woff2" crossorigin />
{!Astro.site && <meta name="robots" content="noindex, nofollow" />}
