---
interface Props { small?: boolean; docs?: boolean }
const { small = false, docs = false } = Astro.props;
---
<a class:list={["brand", { "brand-small": small }]} href="/" aria-label="Roster home">
  <span class="brand-lockup">
    <img class="brand-on-light" src="/roster-lockup-cobalt.svg" width="134" height="37" alt="" />
    <img class="brand-on-dark" src="/roster-lockup-pearl.svg" width="134" height="37" alt="" />
  </span>
  {docs && <span class="brand-docs">Docs</span>}
</a>
