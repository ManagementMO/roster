{
  "name": "@roster/cli",
  "version": "0.0.1",
  "description": "Roster \u2014 the tool router for AI agents. One MCP endpoint, the right five tools per task.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "tool-router",
    "claude",
    "cursor",
    "codex",
    "llm-tools",
    "cli"
  ],
  "homepage": "https://github.com/ManagementMO/roster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManagementMO/roster.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ManagementMO/roster/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "roster": "./bundle/bin.js"
  },
  "main": "./bundle/index.js",
  "exports": {
    ".": "./bundle/index.js"
  },
  "files": [
    "bundle",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "typecheck": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "pnpm run build && node -e \"const f=require('node:fs');f.copyFileSync('../../README.md','README.md');f.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.0",
    "better-sqlite3": "^12.11.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
