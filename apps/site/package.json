{
  "name": "@roster/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "pnpm -w exec vitest run apps/site/test",
    "lint": "pnpm -w exec biome lint --error-on-warnings apps/site",
    "verify:links": "node scripts/check-links.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.9",
    "@iconify-json/tabler": "1.2.43",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.0",
    "pagefind": "1.6.0",
    "typescript": "6.0.3"
  }
}
