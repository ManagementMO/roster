{
  "name": "roster-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "format": "biome format --write .",
    "league:build": "node apps/league/dist/build.js",
    "film:studio": "pnpm --filter @rosterhq/launch-film studio",
    "film:typecheck": "pnpm --filter @rosterhq/launch-film typecheck",
    "film:preview": "pnpm --filter @rosterhq/launch-film render:preview",
    "film:render": "pnpm --filter @rosterhq/launch-film render:master",
    "film:stills": "pnpm --filter @rosterhq/launch-film render:stills",
    "film:poster": "pnpm --filter @rosterhq/launch-film render:poster",
    "film:contact-sheet": "pnpm --filter @rosterhq/launch-film render:contact-sheet",
    "film:redesign-preview": "pnpm --filter @rosterhq/launch-film render:redesign-preview",
    "film:redesign-render": "pnpm --filter @rosterhq/launch-film render:redesign-master",
    "film:redesign-poster": "pnpm --filter @rosterhq/launch-film render:redesign-poster",
    "film:redesign-stills": "pnpm --filter @rosterhq/launch-film render:redesign-stills",
    "film:redesign-contact": "pnpm --filter @rosterhq/launch-film render:redesign-contact",
    "film:redesign-before-after": "pnpm --filter @rosterhq/launch-film render:redesign-before-after",
    "film:diffusion": "pnpm --filter @roster/launch-film-diffusion studio",
    "film:diffusion-check": "pnpm --filter @roster/launch-film-diffusion typecheck",
    "film:diffusion-preview": "pnpm --filter @roster/launch-film-diffusion render:preview",
    "film:diffusion-render": "pnpm --filter @roster/launch-film-diffusion render:master",
    "film:diffusion-poster": "pnpm --filter @roster/launch-film-diffusion render:poster",
    "film:diffusion-contact": "pnpm --filter @roster/launch-film-diffusion render:contact",
    "film:diffusion-stills": "pnpm --filter @roster/launch-film-diffusion render:stills",
    "film:diffusion-before-after": "pnpm --filter @roster/launch-film-diffusion render:before-after",
    "film:inspired": "pnpm --filter @roster/launch-film-diffusion-inspired studio",
    "film:inspired-check": "pnpm --filter @roster/launch-film-diffusion-inspired check",
    "film:inspired-preview": "pnpm --filter @roster/launch-film-diffusion-inspired render:preview",
    "film:inspired-render": "pnpm --filter @roster/launch-film-diffusion-inspired render:master",
    "film:inspired-poster": "pnpm --filter @roster/launch-film-diffusion-inspired render:poster",
    "film:inspired-contact": "pnpm --filter @roster/launch-film-diffusion-inspired render:contact",
    "film:inspired-stills": "pnpm --filter @roster/launch-film-diffusion-inspired render:stills"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
