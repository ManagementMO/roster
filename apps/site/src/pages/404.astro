---
import "../styles/home.css";
import Brand from "../components/Brand.astro";
import ThemeProvider from "../components/ThemeProvider.astro";
import ThemeSelect from "../components/ThemeSelect.astro";
import Icon from "../components/Icon.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeProvider />
    <title>Page not found | Roster</title>
    <meta name="description" content="This page is not in the lineup. Find your way back to Roster or its documentation." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header"><div class="header-inner page-width"><Brand /><ThemeSelect /></div></header>
    <main class="not-found page-width">
      <span class="not-found-code">404</span>
      <h1>Not in this lineup.</h1>
      <p>This page may have moved, or the address may be incomplete. Let’s get you to a useful starting point.</p>
      <div class="hero-actions"><a class="button button-primary" href="/">Back to Roster<Icon name="arrow-right" size={17} /></a><a class="text-link" href="/docs/introduction/">Read the docs</a></div>
    </main>
  </body>
</html>
<style>
  .not-found { padding-block: 100px; max-width: 700px; }
  .not-found-code { font-family: var(--font-code); color: var(--accent); font-size: 18px; }
  h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 550; letter-spacing: -.035em; line-height: 1.1; margin-block: 20px; }
  p { color: var(--muted); font-size: 17px; line-height: 1.8; max-width: 48ch; }
</style>
